ANALYTICS_RECENT_EVENTS=50
GEOIP_DB_PATH=/geoip/GeoLite2-Country.mmdb
# Enable only when every public request reaches the origin through Cloudflare.
TRUST_CLOUDFLARE_HEADERS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_AUTH_METHOD=PLAIN
SMTP_LOCAL_NAME=
MAIL_FROM_NAME=Weblink Shortener
MAIL_FROM_ADDRESS=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_SECRET=
TELEGRAM_WEBAPP_URL=
TELEGRAM_WEBAPP_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_LINK_TTL_MINUTES=10
TELEGRAM_POLL_TIMEOUT_SECONDS=25

# Docker Compose
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
APP_DOMAIN=localhost
ADMIN_DASHBOARD_DOMAIN=pb.localhost
ADMIN_ALLOWED_IP=0.0.0.0/0
