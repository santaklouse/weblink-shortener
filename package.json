{
  "name": "weblink-shortener",
  "version": "1.0.0",
  "private": true,
  "description": "A small Node.js URL shortener backed by PocketBase",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "setup:db": "node scripts/setup-pocketbase.js",
    "test": "node --test",
    "check": "for file in src/*.js scripts/*.js public/*.js; do node --check \"$file\"; done && npm test"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "pocketbase": "0.27.1",
    "zod": "4.4.3"
  }
}
